# Environment variables for Sistema Bomberos Server
# INSTRUCCIONES: Copia este archivo como .env en la misma carpeta (server/)
# Comando: cp .env.example .env  (Linux/Mac)  o  Copy-Item .env.example .env  (Windows)

# Configuración del servidor
NODE_ENV=development
PORT=3002

# Base de datos SQLite (Development) - Listo para usar sin configuración
DATABASE_URL="file:./dev.db"

# NOTA: Para producción con MySQL/PostgreSQL, cambia la línea anterior por:
# DATABASE_URL="mysql://username:password@localhost:3306/sistema_bomberos"
# DATABASE_URL="postgresql://username:password@localhost:5432/sistema_bomberos"

# JWT Secret - CAMBIAR EN PRODUCCIÓN con valor aleatorio seguro
JWT_SECRET=sistema_bomberos_super_secret_key_2024
JWT_EXPIRE=7d

# CORS - Origen del frontend
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Configuración adicional
BCRYPT_SALT_ROUNDS=12