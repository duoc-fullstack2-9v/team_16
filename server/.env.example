# Environment variables for Sistema Bomberos Server

# ==============================================
# CONFIGURACIÓN DEL SERVIDOR
# ==============================================
NODE_ENV=production
PORT=3002

# ==============================================
# BASE DE DATOS - MongoDB Atlas
# ==============================================
# ⚠️ IMPORTANTE: Reemplazar con tus credenciales reales
# Formato: mongodb+srv://usuario:password@cluster.mongodb.net/database?options
DATABASE_URL="mongodb+srv://usuario:password@cluster.mongodb.net/sistema-bomberos?retryWrites=true&w=majority&appName=SGIB-HERO"

# ==============================================
# SEGURIDAD JWT
# ==============================================
# ⚠️ CRÍTICO: Generar un secreto fuerte para producción
# Comando: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_IN_PRODUCTION_USE_A_STRONG_SECRET
JWT_EXPIRE=7d

# ==============================================
# CORS - Control de Acceso
# ==============================================
# Para desarrollo local:
# CORS_ORIGIN=http://localhost:5173
#
# Para producción (separar múltiples origins con comas):
# CORS_ORIGIN=https://tu-app.vercel.app,https://www.tu-app.vercel.app
CORS_ORIGIN=http://localhost:5173

# ==============================================
# RATE LIMITING - Protección contra ataques
# ==============================================
# Habilitar en producción para prevenir abuso
ENABLE_RATE_LIMIT=true
RATE_LIMIT_WINDOW_MS=900000    # 15 minutos
RATE_LIMIT_MAX_REQUESTS=100    # máximo 100 requests por ventana

# ==============================================
# SEGURIDAD ADICIONAL
# ==============================================
BCRYPT_SALT_ROUNDS=12